Options -Indexes -MultiViews
DirectoryIndex disabled

RewriteEngine On

# Canonical website address.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^clickvera\.in$ [NC]
RewriteRule ^ https://clickvera.in%{REQUEST_URI} [R=301,END]

# Keep private Laravel files and hidden files inaccessible.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,END]
RewriteRule ^clickvera(?:/|$) - [F,END,NC]

RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{HTTP:x-xsrf-token} .
RewriteRule ^ - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

# Serve files only from Laravel's public directory.
RewriteCond %{DOCUMENT_ROOT}/clickvera/public/$1 -f
RewriteRule ^(.+)$ clickvera/public/$1 [END]

# Send application routes to Laravel.
RewriteRule ^ clickvera/public/index.php [END]
