Options -Indexes -MultiViews
DirectoryIndex disabled

RewriteEngine On

# Canonical website address: apex -> www (301). Scoped to production
# apex only so staging/local hosts are never redirected.
RewriteCond %{HTTP_HOST} ^clickvera\.in$ [NC]
RewriteRule ^ https://www.clickvera.in%{REQUEST_URI} [R=301,L]

# Enforce HTTPS on www production host only.
RewriteCond %{HTTP_HOST} ^www\.clickvera\.in$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://www.clickvera.in%{REQUEST_URI} [R=301,L]

# Block hidden files and private Laravel directories in public_html.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule ^(?:app|bootstrap|config|database|deployment|resources|routes|tests|vendor|node_modules)(?:/|$) - [F,L,NC]
RewriteRule ^(?:artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|vite\.config\.[^/]+)$ - [F,L,NC]

RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{HTTP:x-xsrf-token} .
RewriteRule ^ - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

# Only expose files from public/, including its public storage link.
RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
RewriteRule ^(.+)$ public/$1 [L]

# Laravel is directly in public_html, not public_html/clickvera.
RewriteRule ^ public/index.php [L]
